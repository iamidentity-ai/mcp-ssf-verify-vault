# Node
node_modules/
dist/
*.log
npm-debug.log*
.npm/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Env files (never commit secrets)
.env
.env.local
.env.*.local
!.env.example

# Vault
infra/vault/data/
infra/vault/file-storage/

# Postgres
infra/postgres/data/

# AgentCore CLI artifacts
agent/agentcore/.cli/
agent/agentcore/.env.local

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Vault plugin binaries are architecture-specific; each dev builds their own.
infra/vault/plugins/*
!infra/vault/plugins/README.md
!infra/vault/plugins/.gitkeep

# Verify bootstrap output (contains client IDs and secrets -- never commit)
infra/verify/verify-output.json
.venv-render/
*.venv-render/

# Token written by scripts/get-clinician-token.sh; gitignored for safety.
.clinician-token.env
# Cookbook build pipeline — internal-only, never published. Kept locally
# for the author's PDF rendering pass but NOT shipped in the public repo.
docs/cookbook-clone.md
docs/cookbook-header.md
docs/cookbook-prereqs.md
scripts/assemble-cookbook.sh
scripts/render-cookbook.py
scripts/requirements-render.txt

# Cookbook build artifacts — regenerated by the (internal-only) pipeline.
COOKBOOK.md
COOKBOOK.docx

# Hand-edited working copies of the cookbook with screenshots / formatting.
# Each version is exported to PDF and that PDF is the committed artifact.
AgentCore-COOKBOOK-V*.docx
# Word lock files
~$*
# Customer-generated AgentCore scaffold (chapter 8 / agentcore-deploy).
# Each customer scaffolds their own; never commit a specific account's
# agentcore.json or CDK project.
agent/vvahealthcareagent/

# Local-only runbooks, scratch scripts, and validation logs. Never commit.
.local/

# IBM Antenna runtime artifacts — never commit
infra/antenna/.env
infra/antenna/deploying/transmitter/configs/keys/*.key
infra/antenna/deploying/transmitter/configs/keys/*.pem
infra/antenna/deploying/transmitter/configs/transmitter.yml
infra/antenna/deploying/transmitter/configs/js/mcp_mapper.js
infra/antenna/deploying/receiver/configs/keys/*.key
infra/antenna/deploying/receiver/configs/keys/*.pem
infra/antenna/deploying/receiver/configs/receiver.yml
infra/antenna/deploying/receiver/configs/js/session_revoked.js
infra/antenna/db/*
!infra/antenna/db/.gitkeep
!infra/antenna/deploying/transmitter/configs/keys/.gitkeep
!infra/antenna/deploying/transmitter/configs/js/.gitkeep
!infra/antenna/deploying/receiver/configs/keys/.gitkeep
!infra/antenna/deploying/receiver/configs/js/.gitkeep
