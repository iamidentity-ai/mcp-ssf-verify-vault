# Copy to .env (gitignored). All values are local-dev defaults; rotate for real use.
#
# DESIGN RULE: the only secret allowed in any .env file is VAULT_TOKEN (the
# bootstrap key the cookbook uses to reach Vault). Once Vault is reachable,
# every other secret lives in Vault. .env is for non-secret config + the
# Vault bootstrap token only.

# ── Verify ───────────────────────────────────────────────────────────────────
# Tenant hostname (no scheme, no trailing slash). Not a secret.
VERIFY_TENANT_HOST=<tenant>.verify.ibm.com

# Admin API client credentials — DO NOT PUT THEM HERE.
# Land them in Vault at secret/VERIFY_ADMIN_CREDS so bootstrap-verify.ts reads
# from there. See docs/verify-setup.md chapter 5 for the canonical
# `docker exec ... vault kv put` command.
# Same rule for the SSF management API client created in chapter 14:
# secret/SSF_CLIENT_ID + secret/SSF_CLIENT_SECRET — read by Antenna's
# configure-antenna.sh, never touched by .env.
#VERIFY_ADMIN_CLIENT_ID=        # use Vault — see comment above
#VERIFY_ADMIN_CLIENT_SECRET=    # use Vault — see comment above

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_ADMIN_USER=vva_admin
POSTGRES_ADMIN_PASSWORD=vva_admin_local_dev_only
POSTGRES_DB=healthcare

# ── Vault (dev mode root token; never use in production) ─────────────────────
VAULT_ADDR=http://127.0.0.1:8200
VAULT_DEV_ROOT_TOKEN=vva-dev-root-token
