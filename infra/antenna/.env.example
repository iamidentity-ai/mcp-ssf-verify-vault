# IBM Antenna v26.03 split-image deployment — mcp-ssf-verify-vault cookbook
#
# Copy this file to .env and edit values before running ./scripts/bootstrap-antenna.sh.
# The bootstrap script reads these to template configs from Vault and start the containers.

# ─────────────────────────────────────────────────────────────────
# Hostnames + ports (defaults work for laptop / docker-compose deployment)
# ─────────────────────────────────────────────────────────────────

# TLS SANs on the generated server certs. For laptop deployment leave as localhost.
# When deploying on a host with a public DNS name, set to that name AND list it in
# the cert SANs (generate-certs.sh appends ${ANTENNA_HOSTNAME} automatically).
ANTENNA_HOSTNAME=localhost

# Public-facing ports (host side; container internal ports are fixed by the v26.03 images).
# The transmitter listens on 9044 (HTTPS, /sources/<id>/events ingester + /.well-known/ssf-configuration).
# The receiver listens on 9043 (HTTPS, /mgmt/v2.0/receivers/config + SET push endpoint).
ANTENNA_TRANSMITTER_PORT=9044
ANTENNA_RECEIVER_PORT=9043

# Docker-internal hostname of the transmitter container — used in the metadataUrl
# the receiver stores at stream-create time. The receiver fetches the URL from
# INSIDE its container, so "localhost" doesn't work (that's the receiver itself).
# Default matches `hostname: antenna-transmitter` in infra/docker-compose.yml.
ANTENNA_TRANSMITTER_INTERNAL_HOSTNAME=antenna-transmitter

# Source ID for events the MCP server posts. Must match transmitter.ingester.sources[].id
# in deploying/transmitter/configs/transmitter.yml. The MCP server's ANTENNA_SOURCE_URL env
# (in mcp-server/.env) should end in /sources/${ANTENNA_SOURCE_ID}/events.
ANTENNA_SOURCE_ID=mcp

# ─────────────────────────────────────────────────────────────────
# IBM Verify tenant — used by the SSF action handler to call DELETE /v1.0/auth/sessions
# ─────────────────────────────────────────────────────────────────

# Tenant hostname (no scheme, no trailing slash). Examples:
#   demos.verify.ibm.com
# This is read by configure-antenna.sh + create-stream.sh + session_revoked.js.
VERIFY_TENANT_HOSTNAME=

# ─────────────────────────────────────────────────────────────────
# Vault access — where configure-antenna.sh reads the SSF management API client credentials
# ─────────────────────────────────────────────────────────────────

# Vault address + token. The cookbook's base infra/docker-compose.yml runs Vault in dev mode
# with root token "vva-dev-root-token" on port 8200 (matches infra/.env.example's
# VAULT_DEV_ROOT_TOKEN). In production, use a properly scoped token via SPIFFE.
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=vva-dev-root-token

# Vault KV paths from which configure-antenna.sh reads the SSF management API client's clientId +
# clientSecret. The customer creates the API client manually in the IBM Verify Admin UI under
# Security -> API (named "mcp-ssf-shared-signals" with five session/grant administration
# entitlements) and lands the credentials in Vault via `docker exec ... vault kv put`. See
# docs/ssf-setup.md chapter 14 step 1 for the walkthrough.
VAULT_SSF_CLIENT_ID_PATH=secret/data/SSF_CLIENT_ID
VAULT_SSF_CLIENT_SECRET_PATH=secret/data/SSF_CLIENT_SECRET
